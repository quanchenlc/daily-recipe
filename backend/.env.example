PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=recipe
DB_PASSWORD=recipe123
DB_NAME=daily_recipe

# Recommendation
COOLDOWN_DAYS=30
PLAN_DAYS=7

# LLM (OpenAI-compatible). Leave LLM_API_KEY empty to use local mock generator.
# DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Auth (WeChat mini program + JWT)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Set true for local/miniprogram dev without WeChat credentials
AUTH_ALLOW_DEV_LOGIN=true
